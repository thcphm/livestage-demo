# Copy to .env.local and fill in. Never commit .env.local.

# Public URL of the site (absolute links in emails, auth redirects)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase → Project Settings → API Keys
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
# Secret key: server only (creating/deleting users, seed). Never expose to the browser.
SUPABASE_SECRET_KEY=sb_secret_...

# Supabase → Connect → Transaction pooler (port 6543), with your database password filled in
DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# Password given to every demo account by `pnpm db:seed` (dev project only, min 8 characters)
SEED_PASSWORD=

# Demo mode: serve the bundled sample data (src/demo) instead of the database, with email + password sign-in
# against the sample accounts. On automatically while Supabase is not configured; set to 1 to force it.
DEMO_MODE=
# Password of the sample accounts in demo mode (default: livestage2026)
DEMO_PASSWORD=
